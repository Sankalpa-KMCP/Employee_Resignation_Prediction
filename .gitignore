# Model artifact directories (keep directory structure with .gitkeep)
models/*/*
!models/*/.gitkeep

# Deliberate reruns keep their serialized models beside the run evidence.
results/models/*/reruns/*/model/


# ============================================================
# Raw / Intermediate / Generated Data
# ============================================================

# Large raw dataset files (with whitelist for canonical benchmark dataset)
data/raw/*
!data/raw/Extended_Employee_Performance_and_Productivity_Data.csv

# Intermediate data
data/interim/

# Ignore generated processed data by default,
# but KEEP the official frozen split registry in Git.
data/processed/*
!data/processed/split_registry.csv

# Common large data formats
*.parquet
*.feather
*.arrow


