{
    "optimizer": "AdamW",
    "weighting": "dynamic_ratio",
    "weight_decay": 1e-05,
    "attention_dropout": 0.1,
    "residual_dropout": 0.0,
    "batch_size": 512,
    "seed": 42,
    "max_epochs": 100,
    "patience": 15,
    "lr_scheduler": "ReduceLROnPlateau",
    "scheduler_factor": 0.5,
    "scheduler_patience": 5,
    "min_delta": 1e-06,
    "n_blocks": 3,
    "d_block": 64,
    "attention_n_heads": 4,
    "ffn_d_hidden": 128,
    "learning_rate": 0.001,
    "ffn_dropout": 0.1,
    "validation_fraction_inner": 0.15
}